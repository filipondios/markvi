{
  "name": "markvi",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run frontend:build && cargo run --quiet --bin markvi -- ./example",
    "frontend:build": "bun run scripts/build-frontend.ts",
    "build": "bun run frontend:build && cargo build --release",
    "test": "cargo test && bun test frontend/",
    "test:e2e": "bun run frontend:build && cargo build --bin markvi && node tests/e2e/browser_e2e.mjs",
    "typecheck": "bun check",
    "demo": "bun run frontend:build && cargo build --bin markvi && bun run scripts/demo.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@replit/codemirror-vim": "^6.4.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4"
  }
}
