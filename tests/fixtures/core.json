      "args": [
        {
          "target": "A",
          "heading": "H",
          "alias": ""
        }
      ],
      "output": "A > H"
    },
    {
      "id": "wiki-label-only-heading",
      "fn": "wikiLabel",
      "args": [
        {
          "target": "",
          "heading": "H",
          "alias": ""
        }
      ],
      "output": "H"
