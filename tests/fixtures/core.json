{
  "cases": [
    {
      "id": "case-lower",
      "fn": "isCaseSensitive",
      "args": [
        "todo"
      ],
      "output": false
    },
    {
      "id": "case-upper",
      "fn": "isCaseSensitive",
      "args": [
        "Todo"
      ],
      "output": true
    },
    {
      "id": "case-caps",
      "fn": "isCaseSensitive",
      "args": [
        "TODO"
      ],
      "output": true
    },
    {
      "id": "case-unicode",
      "fn": "isCaseSensitive",
      "args": [
        "Ärger"
      ],
      "output": true
    },
    {
      "id": "case-turkish",
      "fn": "isCaseSensitive",
      "args": [
        "İstanbul"
      ],
      "output": true
    },
    {
      "id": "path-backslash",
      "fn": "normalizePath",
      "args": [
        "a\\b.md"
      ],
      "output": "a/b.md"
    },
    {
      "id": "path-dot",
      "fn": "normalizePath",
      "args": [
        "./a.md"
      ],
      "output": "a.md"
    },
    {
      "id": "path-slashes",
      "fn": "normalizePath",
      "args": [
        "//a.md"
      ],
      "output": "a.md"
    },
    {
      "id": "path-mixed",
      "fn": "normalizePath",
      "args": [
        "./a\\b.md"
      ],
      "output": "a/b.md"
    },
    {
      "id": "md-upper",
      "fn": "isMarkdownPath",
      "args": [
        "A.MD"
      ],
      "output": true
    },
    {
      "id": "md-txt",
      "fn": "isMarkdownPath",
      "args": [
        "a.txt"
      ],
      "output": false
    },
    {
      "id": "safe-ok",
      "fn": "isSafePath",
      "args": [
        "a/b.md"
      ],
      "output": true
    },
    {
      "id": "safe-dotdot",
      "fn": "isSafePath",
      "args": [
        "../secreto.md"
      ],
      "output": false
    },
    {
      "id": "safe-hidden",
      "fn": "isSafePath",
      "args": [
        ".oculto.md"
      ],
      "output": false
    },
    {
      "id": "safe-backslash",
      "fn": "isSafePath",
      "args": [
        "a\\b.md"
      ],
      "output": false
    },
    {
      "id": "safe-double",
      "fn": "isSafePath",
      "args": [
        "a//b.md"
      ],
      "output": false
    },
    {
      "id": "newpath-sub",
      "fn": "normalizeNewPath",
      "args": [
        "notas/idea"
      ],
      "output": "notas/idea.md"
    },
    {
      "id": "newpath-dot",
      "fn": "normalizeNewPath",
      "args": [
        "./idea.md"
      ],
      "output": "idea.md"
    },
    {
      "id": "newpath-parent",
      "fn": "normalizeNewPath",
      "args": [
        "../idea"
      ],
      "output": null
    },
    {
      "id": "newpath-txt",
      "fn": "normalizeNewPath",
      "args": [
        "idea.txt"
      ],
      "output": "idea.txt.md"
    },
    {
      "id": "newpath-unicode",
      "fn": "normalizeNewPath",
      "args": [
        "  notas/idea ñ  "
      ],
      "output": "notas/idea ñ.md"
    },
    {
      "id": "split-root",
      "fn": "splitPath",
      "args": [
        "a.md"
      ],
      "output": {
        "dir": "",
        "name": "a.md"
      }
    },
    {
      "id": "split-dir",
      "fn": "splitPath",
      "args": [
        "a/b/c.md"
      ],
      "output": {
        "dir": "a/b",
        "name": "c.md"
      }
    },
    {
      "id": "viewurl-space",
      "fn": "viewUrl",
      "args": [
        "a b/c.md"
      ],
      "output": "/view/a%20b/c.md"
    },
    {
      "id": "fileurl-space",
      "fn": "fileUrl",
      "args": [
        "a b/c.md"
      ],
      "output": "/api/file?path=a%20b%2Fc.md"
    },
    {
      "id": "encode-unicode",
      "fn": "encodeURIComponent",
      "args": [
        "ñ &"
      ],
      "output": "%C3%B1%20%26"
    },
    {
      "id": "default-config",
      "fn": "defaultConfig",
      "args": [],
      "output": {
        "leader": " ",
        "theme": "auto",
        "font": null,
        "editor": {
          "number": true,
          "relativenumber": false,
          "scrolloff": 0
        },
        "leaderBindings": [
          {
            "keys": [
              "f"
            ],
            "action": "find"
          },
          {
            "keys": [
              "/"
            ],
            "action": "grep"
          },
          {
            "keys": [
              "r"
            ],
            "action": "recent"
          },
          {
            "keys": [
              "a"
            ],
            "action": "alternate"
          },
          {
            "keys": [
              "t"
            ],
            "action": "toc"
          },
          {
            "keys": [
              "b"
            ],
            "action": "backlinks"
          },
          {
            "keys": [
              "x"
            ],
            "action": "close"
          }
        ],
        "viewRemap": {},
        "vimMappings": [],
        "render": {
          "footnotes": true,
          "alerts": true,
          "frontmatter": true,
          "remoteimages": false
        }
      }
    },
    {
      "id": "wiki-simple",
      "fn": "parseWikiLink",
      "args": [
        "Nota"
      ],
      "output": {
        "target": "Nota",
        "heading": "",
        "alias": ""
      }
    },
    {
      "id": "wiki-heading",
      "fn": "parseWikiLink",
      "args": [
        "Nota#Título"
      ],
      "output": {
        "target": "Nota",
        "heading": "Título",
        "alias": ""
      }
    },
    {
      "id": "wiki-only-heading",
      "fn": "parseWikiLink",
      "args": [
        "#Título"
      ],
      "output": {
        "target": "",
        "heading": "Título",
        "alias": ""
      }
    },
    {
      "id": "wiki-alias",
      "fn": "parseWikiLink",
      "args": [
        "Nota|texto"
      ],
      "output": {
        "target": "Nota",
        "heading": "",
        "alias": "texto"
      }
    },
    {
      "id": "wiki-spaces",
      "fn": "parseWikiLink",
      "args": [
        " Nota # Sec | alias "
      ],
      "output": {
        "target": "Nota",
        "heading": "Sec",
        "alias": "alias"
      }
    },
    {
      "id": "wiki-empty",
