      ],
      "output": null
    },
    {
      "id": "wiki-links",
      "fn": "wikiLinks",
      "args": [
        "uno [[A]] dos [[B|b]] tres"
      ],
      "output": [
        [
          4,
          "[[A]]",
          {
            "target": "A",
            "heading": "",
            "alias": ""
          }
        ],
        [
          14,
          "[[B|b]]",
          {
            "target": "B",
            "heading": "",
            "alias": "b"
          }
        ]
      ]
    },
    {
      "id": "wiki-label-target",
      "fn": "wikiLabel",
      "args": [
        {
          "target": "A",
          "heading": "",
          "alias": ""
        }
      ],
      "output": "A"
    },
