{
  "schema": "markvi-baseline-cases@1",
  "source_of_truth": "src/api.ts + server.ts + src/paths.ts + src/constants.ts; methods and paths are taken from code, not from names",
  "server": {
    "command": [
      "bun",
      "run",
      "server.ts",
      "{root}",
      "--port",
      "{port}"
    ],
    "cwd": "repository root",
    "hostname": "127.0.0.1"
  },
  "fixture": {
    "source": "example",
    "strategy": "copy to a temporary directory; original example/ is never written",
    "extras": [
      "img.svg (synthetic raw asset)",
      "nota.txt (synthetic non-Markdown file)",
      ".git/hidden.md (synthetic ignored file)",
      "enlace.md -> index.md (synthetic symlink inside root)",
      "enlace-fuera.md -> ../outside.md (synthetic symlink escaping root)",
      "outside.md (outside the served root)",
      "solo-lectura.md (chmod 0444 for one case)"
    ]
  },
  "expectation_keys": {
    "status": "exact HTTP status",
    "headers": "case-insensitive name -> exact value",
    "body_exact": "exact decoded body",
    "body_contains": "substring of decoded body",
    "json_exact": "deep JSON equality (raw order still stored in baseline)",
    "json_fields": "dotted path -> exact JSON value",
    "json_contains": "substring of raw JSON text",
    "etag_pattern": "ETag matches /^\"[0-9a-f]+\"$/",
    "fs_after": "path -> {content, content_from, absent, symlink_target, mode} checked on the fixture copy"
  },
  "cases": [
    {
      "id": "static-root",
      "group": "static",
      "method": "GET",
      "path": "/",
      "expect": {
        "status": 200,
        "headers": {
          "content-type": "text/html;charset=utf-8",
          "cache-control": "no-cache"
        },
        "body_contains": "<!doctype html>"
      }
    },
    {
      "id": "static-view",
      "group": "static",
      "method": "GET",
      "path": "/view/index.md",
      "expect": {
        "status": 200,
        "headers": {
          "content-type": "text/html;charset=utf-8"
        },
        "body_contains": "<!doctype html>"
      }
    },
    {
      "id": "fallback-404",
      "group": "static",
      "method": "GET",
      "path": "/no-existe",
      "expect": {
        "status": 404,
        "body_exact": "Not found"
      }
    },
    {
      "id": "tree-get",
      "group": "read",
      "method": "GET",
      "path": "/api/tree",
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "json_exact": {
          "files": [
            "enlace.md",
            "finding-files.md",
            "index.md",
            "keyboard-shortcuts.md",
            "markdown-basics.md",
            "render-extras.md",
            "solo-lectura.md",
            "wiki-links.md"
          ]
        }
      }
    },
    {
      "id": "tree-post",
      "group": "read",
      "method": "POST",
      "path": "/api/tree",
      "body": "",
      "expect": {
        "status": 404
      }
    },
    {
      "id": "config-get",
      "group": "read",
      "method": "GET",
      "path": "/api/config",
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "json_fields": {
          "config.theme": "auto",
          "config.leader": " ",
          "config.editor.number": true,
          "exists": false,
          "warnings": []
        }
      }
    },
    {
      "id": "file-get",
      "group": "read",
      "method": "GET",
      "path": "/api/file?path=index.md",
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "no-store",
          "content-type": "text/plain; charset=utf-8"
        },
        "etag_pattern": true,
        "content_from": "example/index.md"
      }
    },
    {
      "id": "file-get-missing-param",
      "group": "read",
      "method": "GET",
      "path": "/api/file",
      "expect": {
        "status": 400,
        "json_exact": {
          "error": "Missing or invalid path."
        }
      }
    },
    {
      "id": "file-get-non-md",
      "group": "read",
      "method": "GET",
      "path": "/api/file?path=config.toml",
      "expect": {
        "status": 400,
        "json_exact": {
          "error": "Only .md files are supported."
        }
      }
    },
    {
      "id": "file-get-missing",
      "group": "read",
      "method": "GET",
      "path": "/api/file?path=no.md",
      "expect": {
        "status": 404,
        "json_exact": {
          "error": "File not found."
        }
      }
    },
    {
      "id": "file-get-traversal",
      "group": "read",
      "method": "GET",
      "path": "/api/file?path=..%2Foutside.md",
      "expect": {
        "status": 403,
        "json_exact": {
          "error": "Path outside the root directory."
        }
      }
    },
    {
      "id": "file-get-hidden",
      "group": "read",
      "method": "GET",
      "path": "/api/file?path=.git%2Fhidden.md",
      "expect": {
        "status": 404,
        "json_exact": {
          "error": "File not found."
        }
      }
    },
    {
      "id": "file-get-symlink-out",
      "group": "read",
      "method": "GET",
      "path": "/api/file?path=enlace-fuera.md",
      "expect": {
        "status": 403,
        "json_exact": {
          "error": "Path outside the root directory."
        }
      }
    },
    {
      "id": "files-raw-svg",
      "group": "read",
      "method": "GET",
      "path": "/files/img.svg",
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "no-store",
          "content-security-policy": "sandbox",
          "x-content-type-options": "nosniff",
          "content-type": "image/svg+xml"
        },
        "body_contains": "<svg"
      }
    },
    {
      "id": "files-raw-markdown",
      "group": "read",
      "method": "GET",
      "path": "/files/index.md",
      "expect": {
        "status": 200,
        "headers": {
          "content-security-policy": "sandbox",
          "x-content-type-options": "nosniff",
          "content-type": "text/markdown"
        },
        "body_contains": "MarkVi"
      }
    },
    {
      "id": "files-raw-traversal",
      "group": "read",
      "method": "GET",
      "path": "/files/%2e%2e%2foutside.md",
      "expect": {
        "status": 403,
        "json_exact": {
          "error": "Path outside the root directory."
        }
      }
    },
    {
      "id": "files-raw-hidden",
      "group": "read",
      "method": "GET",
      "path": "/files/.git/hidden.md",
      "expect": {
        "status": 404,
        "json_exact": {
          "error": "File not found."
        }
      }
    },
    {
      "id": "search-ok",
      "group": "read",
      "method": "GET",
      "path": "/api/search?q=tour",
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "json_contains": [
          "\"truncated\":false"
        ],
        "json_fields": {
          "truncated": false
        }
      }
    },
    {
      "id": "search-empty",
      "group": "read",
      "method": "GET",
      "path": "/api/search?q=",
      "expect": {
        "status": 200,
        "json_exact": {
          "results": [],
          "truncated": false
        }
      }
    },
    {
      "id": "search-too-long",
      "group": "read",
      "method": "GET",
      "path": "/api/search?q=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expect": {
        "status": 400,
        "json_exact": {
          "error": "The query is too long."
        }
      }
    },
    {
      "id": "backlinks-ok",
      "group": "read",
      "method": "GET",
      "path": "/api/backlinks?path=index.md",
      "expect": {
        "status": 200,
        "headers": {
          "cache-control": "no-store"
        },
        "json_contains": [
          "\"results\""
        ],
        "json_fields": {
          "results.0.path": "render-extras.md"
        }
      }
    },
    {
      "id": "backlinks-missing",
      "group": "read",
      "method": "GET",
      "path": "/api/backlinks?path=no.md",
      "expect": {
        "status": 404,
        "json_exact": {
          "error": "File not found."
        }
      }
    },
    {
      "id": "guard-host",
      "group": "guard",
      "method": "GET",
      "path": "/api/tree",
      "headers": {
        "Host": "evil.example"
      },
      "expect": {
        "status": 403,
        "json_exact": {
          "error": "Host not allowed."
        }
      }
    },
    {
      "id": "guard-origin",
      "group": "guard",
      "method": "POST",
      "path": "/api/file?path=csrf.md",
      "headers": {
        "Origin": "http://evil.example"
      },
      "body": "x",
      "expect": {
        "status": 403,
        "json_exact": {
          "error": "Origin not allowed."
        },
        "fs_after": {
          "csrf.md": {
            "absent": true
          }
        }
      }
    },
    {
      "id": "file-put",
      "group": "mutate",
      "method": "PUT",
      "path": "/api/file?path=index.md",
      "body": "# editado\n",
      "expect": {
        "status": 204,
        "headers": {
          "cache-control": "no-store"
        },
        "etag_pattern": true,
        "fs_after": {
          "index.md": {
            "content": "# editado\n"
          }
        }
      }
    },
    {
      "id": "file-put-stale-ifmatch",
      "group": "mutate",
      "method": "PUT",
      "path": "/api/file?path=index.md",
      "headers": {
        "If-Match": "\"deadbeef\""
      },
      "body": "# no escribir\n",
      "expect": {
        "status": 409,
        "json_contains": [
          "The file changed on disk.",
          "\"etag\""
        ],
        "fs_after": {
          "index.md": {
            "content_from": "example/index.md"
          }
        }
      }
    },
    {
      "id": "file-put-valid-ifmatch",
      "group": "flow",
      "steps": [
        {
          "method": "GET",
          "path": "/api/file?path=index.md"
        },
        {
          "method": "PUT",
          "path": "/api/file?path=index.md",
          "headers": {
            "If-Match": "${etag}"
          },
          "body": "# flujo\n"
        }
      ],
      "expect": {
        "status": 204,
        "etag_pattern": true,
        "fs_after": {
          "index.md": {
            "content": "# flujo\n"
          }
        }
      }
    },
    {
      "id": "file-put-create",
      "group": "mutate",
      "method": "PUT",
      "path": "/api/file?path=nuevo.md&create=1",
      "body": "# nuevo\n",
      "expect": {
        "status": 204,
        "etag_pattern": true,
        "fs_after": {
          "nuevo.md": {
            "content": "# nuevo\n"
          }
        }
      }
    },
    {
      "id": "file-put-create-parent-missing",
      "group": "mutate",
      "method": "PUT",
      "path": "/api/file?path=nada/nuevo.md&create=1",
      "body": "x",
      "expect": {
        "status": 404,
        "fs_after": {
          "nada/nuevo.md": {
            "absent": true
          }
        },
        "json_exact": {
          "error": "The file's folder does not exist."
        }
      }
    },
    {
      "id": "file-put-create-traversal",
      "group": "mutate",
      "method": "PUT",
      "path": "/api/file?path=..%2Foutside.md&create=1",
      "body": "x",
      "expect": {
        "status": 403,
        "fs_after": {
          "../outside.md": {
            "content": "# fuera\n"
          }
        }
      }
    },
    {
      "id": "file-put-create-hidden",
      "group": "mutate",
      "method": "PUT",
      "path": "/api/file?path=.git%2Fhidden.md&create=1",
      "body": "x",
      "expect": {
        "status": 404
      }
    },
    {
      "id": "file-post-create",
      "group": "mutate",
      "method": "POST",
      "path": "/api/file?path=creado.md",
      "body": "# creado\n",
      "expect": {
        "status": 201,
        "etag_pattern": true,
        "fs_after": {
          "creado.md": {
            "content": "# creado\n"
          }
        }
      }
    },
    {
      "id": "file-post-duplicate",
      "group": "mutate",
      "method": "POST",
      "path": "/api/file?path=index.md",
      "body": "# duplicado\n",
      "expect": {
        "status": 409,
        "json_exact": {
          "error": "A file already exists at that path."
        },
        "fs_after": {
          "index.md": {
            "content_from": "example/index.md"
          }
        }
      }
    },
    {
      "id": "file-post-invalid-ext",
      "group": "mutate",
      "method": "POST",
      "path": "/api/file?path=nota.txt",
      "body": "x",
      "expect": {
        "status": 400,
        "json_exact": {
          "error": "Only .md files are supported."
        },
        "fs_after": {
          "nota.txt": {
            "content": "texto\n"
          }
        }
      }
    },
    {
      "id": "file-post-traversal",
      "group": "mutate",
      "method": "POST",
      "path": "/api/file?path=..%2Ffuera.md",
      "body": "x",
      "expect": {
        "status": 403
      }
    },
    {
      "id": "file-delete",
      "group": "mutate",
      "method": "DELETE",
      "path": "/api/file?path=index.md",
      "expect": {
        "status": 204,
        "headers": {
          "cache-control": "no-store"
        },
        "fs_after": {
          "index.md": {
            "absent": true
          }
        }
      }
    },
    {
      "id": "file-delete-missing",
      "group": "mutate",
      "method": "DELETE",
      "path": "/api/file?path=no.md",
      "expect": {
        "status": 404
      }
    },
    {
      "id": "file-delete-stale-ifmatch",
      "group": "mutate",
      "method": "DELETE",
      "path": "/api/file?path=index.md",
      "headers": {
        "If-Match": "\"deadbeef\""
      },
      "expect": {
        "status": 409,
        "json_contains": [
          "The file changed on disk."
        ],
        "fs_after": {
          "index.md": {
            "content_from": "example/index.md"
          }
        }
      }
    },
    {
      "id": "move-ok",
      "group": "mutate",
      "method": "POST",
      "path": "/api/move",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"from\":\"index.md\",\"to\":\"movido/index.md\"}",
      "expect": {
        "status": 204,
        "fs_after": {
          "index.md": {
            "absent": true
          },
          "movido/index.md": {
            "content_from": "example/index.md"
          }
        }
      }
    },
    {
      "id": "move-dest-exists",
      "group": "mutate",
      "method": "POST",
      "path": "/api/move",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"from\":\"index.md\",\"to\":\"wiki-links.md\"}",
      "expect": {
        "status": 409,
        "json_exact": {
          "error": "A file already exists at that path."
        },
        "fs_after": {
          "index.md": {
            "content_from": "example/index.md"
          }
        }
      }
    },
    {
      "id": "move-missing-from",
      "group": "mutate",
      "method": "POST",
      "path": "/api/move",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"from\":\"no.md\",\"to\":\"si.md\"}",
      "expect": {
        "status": 404
      }
    },
    {
      "id": "move-invalid-json",
      "group": "mutate",
      "method": "POST",
      "path": "/api/move",
      "body": "no-json",
      "expect": {
        "status": 400,
        "json_exact": {
          "error": "Missing or invalid path."
        }
      }
    },
    {
      "id": "move-symlink",
      "group": "mutate",
      "method": "POST",
      "path": "/api/move",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"from\":\"enlace.md\",\"to\":\"copia-enlace.md\"}",
      "expect": {
        "status": 204,
        "fs_after": {
          "enlace.md": {
            "absent": true
          },
          "copia-enlace.md": {
            "symlink_target": "index.md"
          }
        }
      }
    },
    {
      "id": "put-readonly",
      "group": "mutate",
      "method": "PUT",
      "path": "/api/file?path=solo-lectura.md",
      "body": "editado",
      "fs_before": {
        "solo-lectura.md": {
          "mode": "0o444"
        }
      },
      "expect": {
        "status": 204,
        "etag_pattern": true,
        "fs_after": {
          "solo-lectura.md": {
            "content": "editado",
            "mode": "0o444"
          }
        }
      }
    },
    {
      "id": "sse-events",
      "group": "sse",
      "kind": "sse",
      "expect": {
        "status": 200,
        "headers": {
          "content-type": "text/event-stream",
          "cache-control": "no-store",
          "x-accel-buffering": "no"
        },
        "change_event": "evento.md",
        "heartbeat": true,
        "reconnect": true
      }
    },
    {
      "id": "watcher-direct",
      "group": "watcher",
      "kind": "watcher",
      "expect": {
        "events_contain": [
          {
            "type": "change",
            "path": "watch-a.md"
          },
          {
            "type": "delete",
            "path": "watch-b.md"
          }
        ]
      }
    }
  ]
}
